{
  "name": "fastang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Angular. Full Fastify. An experimental full-stack framework.",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "fastang dev",
    "generate": "fastang generate",
    "check": "npm run generate && ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run check && fastang build",
    "start": "node dist/server/index.js",
    "test": "npm run generate && node --import tsx scripts/test.ts",
    "test:production": "node --import tsx scripts/test.ts --production",
    "brand:assets": "node --import tsx scripts/brand-assets.ts",
    "author:assets": "node --import tsx scripts/author-assets.ts",
    "build:vercel": "npm run check && fastang build --vercel",
    "test:vercel": "node --import tsx scripts/test.ts --vercel",
    "core:build": "npm run build --workspace @fastang/core",
    "postinstall": "npm run core:build && npm run create:build",
    "test:starter": "node --import tsx scripts/test-starter.ts",
    "dev:starter": "npm run dev --workspace fastang-starter",
    "create:build": "npm run build --workspace create-fastang",
    "create": "npm run create:build && create-fastang",
    "release:pack": "node --import tsx scripts/pack-release.ts",
    "release:check": "npm run check && npm test && npm run build:vercel && npm run test:production && npm run test:vercel && npm run test:starter && npm run test:docs && npm audit --audit-level=high && npm run release:pack",
    "test:docs": "node --import tsx scripts/test-docs.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@fastify/middie": "^9.0.3",
    "@fastify/static": "^10.1.6",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.12.7",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "@fastang/core": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.1",
    "@angular/build": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/node": "^22.19.0",
    "@vercel/nft": "^1.11.0",
    "light-my-request": "^6.8.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "8.3.4",
    "create-fastang": "0.1.0-alpha.0"
  },
  "license": "MIT",
  "author": "Dario Chiapperini",
  "homepage": "https://fastang.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daclab-dev/fastang.git"
  },
  "bugs": {
    "url": "https://github.com/daclab-dev/fastang/issues"
  },
  "workspaces": [
    "packages/*",
    "examples/starter"
  ]
}
